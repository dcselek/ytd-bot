# Telegram'da @BotFather ile bot olusturup aldiginiz token
TELEGRAM_BOT_TOKEN=

# /calistir komutunu kullanabilecek chat id'ler (virgulle ayrilir). Bos ise herkes kullanabilir.
ADMIN_CHAT_IDS=

# Bos birakilirsa bot kural tabanli yedek analize duser (API'siz de calisir)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Analiz dongusu sikligi (saat)
CYCLE_HOURS=4

# Temsili portfoy
START_CAPITAL_TRY=100000
BROKER_FEE_BPS=15

# Likit fon / para piyasasi icin varsayilan yillik getiri (%)
MONEY_MARKET_ANNUAL_RATE=42

# Advisor discipline: sepetin sik degismesini engelleyen kurallar
MIN_BASKET_LIFETIME_DAYS=14
REGIME_CONFIRMATION_CYCLES=3
MIN_SWITCH_CONFIDENCE=6
EMERGENCY_SWITCH_CONFIDENCE=8
MIN_WEIGHT_DRIFT_PCT=5

# Haber toplama
NEWS_LOOKBACK_HOURS=12
MAX_NEWS_ITEMS=40

# Kullanici takip sepeti (/sepetim)
MAX_WATCHLIST_ITEMS=15

DB_PATH=data/ytdbot.sqlite3
